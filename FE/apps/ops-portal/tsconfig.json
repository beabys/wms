{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@wms/ui": ["../../packages/ui/src/index.ts"],
      "@wms/ui/*": ["../../packages/ui/src/*"],
      "@wms/composables": ["../../packages/composables/src/index.ts"],
      "@wms/composables/*": ["../../packages/composables/src/*"],
      "@wms/api-client": ["../../packages/api-client/src/index.ts"],
      "@wms/api-client/*": ["../../packages/api-client/src/*"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"]
}
