# PostgreSQL
AUTH_DB_HOST=localhost
AUTH_DB_PORT=5432
AUTH_DB_USER=wms
AUTH_DB_PASSWORD=wms
AUTH_DB_NAME=wms_auth

CUSTOMER_DB_HOST=localhost
CUSTOMER_DB_PORT=5432
CUSTOMER_DB_USER=wms
CUSTOMER_DB_PASSWORD=wms
CUSTOMER_DB_NAME=wms_customer

# JWT
JWT_PRIVATE_KEY=   # RS256 private key PEM
JWT_PUBLIC_KEY=    # RS256 public key PEM
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# gRPC Ports
AUTH_GRPC_PORT=50001
CUSTOMER_GRPC_PORT=50002

# HTTP Ports (BFF)
AUTH_BFF_PORT=8081
CUSTOMER_BFF_PORT=8082

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Frontend
ADMIN_UI_PORT=5173
CUSTOMER_UI_PORT=5174

# Docker Network
NETWORK_NAME=wms-net

# Logging
LOG_LEVEL=debug
