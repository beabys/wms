server:
  host: "0.0.0.0"
  port: 50051

database:
  host: "localhost"
  port: 5432
  user: "postgres"
  password: "postgres"
  dbname: "auth_service"
  sslmode: "disable"
  max_idle_conns: 10
  max_open_conns: 25
  conn_max_lifetime: 300

jwt:
  secret: "change-me-in-production"
  access_token_ttl: 15m
  refresh_token_ttl: 7d

log:
  level: "debug"
